# Copy to .env (Expo loads EXPO_PUBLIC_* at bundle time; restart `expo start` after changes).

# Backend base URL.
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Auth mode:
#   oidc         (default) Keycloak login, Authorization: Bearer <access token>.
#   dev-headers  legacy role switcher + X-Tenant-Id / X-Actor-Role / X-Specialist-Id headers.
#                Works only when the backend runs in its `dev-headers` profile.
EXPO_PUBLIC_AUTH_MODE=oidc

# OIDC issuer (Keycloak realm from docker-compose, port 8081). Discovery is read from
# <issuer>/.well-known/openid-configuration.
EXPO_PUBLIC_OIDC_ISSUER=http://localhost:8081/realms/cadence

# Public client with PKCE (S256) registered in docker/keycloak/realm-cadence.json.
EXPO_PUBLIC_OIDC_CLIENT_ID=cadence-app

# NOTE: Expo's default web port (8081) collides with Keycloak's 8081. Run the web dev server on
# 8082 (`npx expo start --web --port 8082`) or 19006; both are registered redirect URIs.
