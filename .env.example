# Local LLM (copy to .env — gitignored). Do not put real keys in git.
APP_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
APP_AI_MODEL=deepseek-flash
# Optional:
# APP_AI_FALLBACK_PROVIDER=stub
# APP_AI_REASONING_EFFORT=high
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# APP_AI_DEEPSEEK_THINKING=disabled

# Database (defaults match docker-compose for local development; set real secrets elsewhere).
# Runtime pool role (created by Flyway migration V7, subject to RLS):
# APP_DB_USER=cadence_app
# APP_DB_PASSWORD=cadence_app
# Migration / schema-owner role used only by Flyway:
# FLYWAY_DB_USER=cadence
# FLYWAY_DB_PASSWORD=cadence
