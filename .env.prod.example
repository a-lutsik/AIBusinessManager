# Production environment for docker-compose.prod.yml.
#   cp .env.prod.example .env.prod   (.env.prod is gitignored; never commit real values)
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# SECRETS ARE DELIBERATELY EMPTY: this file is public, so it carries no usable credentials. Fill in every empty value
# below; compose refuses to start (and names the variable) while any required one is empty.
# Generate each secret separately with `openssl rand -hex 24` (hex is safe). Secret values must NOT contain `$`, `'`,
# spaces or `#`: Compose interpolates `$`, and the application's Flyway migration rejects `'` and `$` in APP_DB_PASSWORD.
# Every variable without a default below is required.

# --- Public URLs -------------------------------------------------------------------------------------------------------
# Public https URL of Keycloak as browsers see it (your reverse proxy forwards it to 127.0.0.1:8081). No trailing slash.
# Tokens carry <KC_HOSTNAME>/realms/cadence as issuer; the backend validates exactly that.
KC_HOSTNAME=https://auth.example.com

# Origin (scheme + host [+ port], no path, no trailing slash) the web console is served from. Used for:
#  - Keycloak client cadence-app: redirect URI <origin>/auth, web origin, post-logout redirect;
#  - backend CORS allow-list (app.cors.allowed-origins).
CADENCE_WEB_ORIGIN=https://app.example.com

# --- Database passwords (two different roles, two different secrets) ----------------------------------------------------
# REQUIRED secret. Schema owner `cadence`: used by Flyway migrations only. Must not be `cadence` and must differ from
# APP_DB_PASSWORD. Generate: openssl rand -hex 24
FLYWAY_DB_PASSWORD=
# REQUIRED secret. Runtime role `cadence_app` (non-owner, subject to row-level security). Must not be `cadence_app`.
# Generate: openssl rand -hex 24
APP_DB_PASSWORD=
# REQUIRED secret. Keycloak's own database (separate PostgreSQL service, user `keycloak`). Generate: openssl rand -hex 24
KEYCLOAK_DB_PASSWORD=

# --- Keycloak admin (created on the first start of an empty Keycloak database only) ------------------------------------
# REQUIRED. Pick a non-guessable admin user name (not `admin`), e.g. `kcadmin-` + `openssl rand -hex 4`.
KC_BOOTSTRAP_ADMIN_USERNAME=
# REQUIRED secret. Generate: openssl rand -hex 24
KC_BOOTSTRAP_ADMIN_PASSWORD=

# --- Reverse proxy / rate limits (optional) ---------------------------------------------------------------------------
# CIDRs of the proxy the backend sees as TCP peer; only for them X-Forwarded-For is trusted (public rate limits are per
# client IP). With the proxy on the Docker host this is the compose network gateway, typically 172.16.0.0/12 (check with
# `docker network inspect cadence_default`). Empty: all clients share the proxy's IP. Never list ranges clients reach directly.
APP_RATE_LIMIT_TRUSTED_PROXIES=

# --- Backups (optional; defaults shown) ----------------------------------------------------------------------------------
# The `backup` service dumps both databases into BACKUP_DIR (host directory, relative paths are relative to the compose
# file). Keep this directory out of git and OFF the data disk's single point of failure: copy it offsite (README).
# BACKUP_DIR=./backups
# Interval between backups: seconds or 30m / 6h / 1d (minimum 60 s). Retention in days; the newest BACKUP_KEEP_MIN
# backups are always kept, whatever their age.
# BACKUP_INTERVAL=6h
# BACKUP_RETENTION_DAYS=14
# BACKUP_KEEP_MIN=3
# Minimum free space (MB) in BACKUP_DIR before a dump; old backups are pruned first, the run fails if still short.
# BACKUP_MIN_FREE_MB=1024
# Write backup files as this host user instead of root (create BACKUP_DIR yourself first).
# BACKUP_UID=
# BACKUP_GID=

# --- Optional ----------------------------------------------------------------------------------------------------------
# AI provider: `stub` (default, no external calls) or `deepseek` together with DEEPSEEK_API_KEY.
# APP_AI_PROVIDER=stub
# DEEPSEEK_API_KEY=
# JVM flags for the backend container.
# JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
