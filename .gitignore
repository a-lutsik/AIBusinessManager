!**/application-local.yml.example

# Node / Expo
frontend/node_modules/
frontend/.expo/
frontend/dist/
frontend/web-build/
npm-debug.*
yarn-error.log

# Java
*.class
*.jar
!**/gradle-wrapper.jar
*.log

# Generated (rebuilt by jooqCodegen)
backend/modules/platform/build/generated-sources/

# Playwright MCP browser artifacts
.playwright-mcp/

