{
  "realm": "cadence",
  "enabled": true,
  "displayName": "Cadence",
  "displayNameHtml": "Cadence",
  "loginTheme": "cadence",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": ["ru", "en"],
  "defaultLocale": "ru",
  "roles": {
    "realm": [
      {
        "name": "OWNER",
        "description": "Tenant owner"
      },
      {
        "name": "MASTER",
        "description": "Specialist / master"
      }
    ]
  },
  "clients": [
    {
      "clientId": "cadence-app",
      "name": "Cadence Console",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:8081/*",
        "http://localhost:8082/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "specialist_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "specialist_id",
            "claim.name": "specialist_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "cadence-backend",
      "name": "Cadence API Resource Server",
      "enabled": true,
      "publicClient": false,
      "secret": "cadence-backend-secret",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "owner@lumen.studio",
      "enabled": true,
      "email": "owner@lumen.studio",
      "firstName": "Lumen",
      "lastName": "Owner",
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "owner",
          "temporary": false
        }
      ],
      "realmRoles": [
        "OWNER"
      ]
    },
    {
      "username": "nino@lumen.studio",
      "enabled": true,
      "email": "nino@lumen.studio",
      "firstName": "Nino",
      "lastName": "Beridze",
      "attributes": {
        "tenant_id": [
          "00000000-0000-4000-8000-000000000001"
        ],
        "specialist_id": [
          "00000000-0000-4000-8000-000000000011"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "nino",
          "temporary": false
        }
      ],
      "realmRoles": [
        "MASTER"
      ]
    }
  ]
}